PORT=4173
# Optional managed PostgreSQL. If omitted, persistent embedded PostgreSQL runs locally.
DATABASE_URL=
DATA_DIR=.data
# Set your HTTPS demo hostname or this computer's LAN URL before phone handoff.
PUBLIC_BASE_URL=http://localhost:4173
# Generated into .data/demo-access.txt on first local run if omitted.
ADMIN_PASSWORD=
SECURE_COOKIES=false
